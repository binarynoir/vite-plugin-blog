{
  "name": "@binarynoir/vite-plugin-blog",
  "version": "0.2.0",
  "description": "A static Markdown blog for any Vite site. Posts become plain HTML pages in your own page shell, with build-time Shiki highlighting that works under a strict Content Security Policy, checked front matter, drafts, scheduled posts and custom ::: directives.",
  "keywords": [
    "vite",
    "vite-plugin",
    "blog",
    "markdown",
    "markdown-it",
    "shiki",
    "static-site",
    "mpa",
    "csp"
  ],
  "license": "MIT",
  "author": "BinaryNoir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binarynoir/vite-plugin-blog.git"
  },
  "homepage": "https://github.com/binarynoir/vite-plugin-blog#readme",
  "bugs": {
    "url": "https://github.com/binarynoir/vite-plugin-blog/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "@shikijs/transformers": "^4.6.0",
    "image-size": "^2.1.0",
    "markdown-it": "^15.0.3",
    "shiki": "^4.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
